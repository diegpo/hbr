.env

# Ambiente virtual Python
venv/
.venv/
env/

# Caches do Python
__pycache__/
*.py[cod]
*$py.class

# Configurações do VS Code
.vscode/

# Arquivos do sistema operacional
.DS_Store
Thumbs.db

# Ficheiros de imagem Docker exportados
*.tar

# Ignora tudo dentro da pasta e subpastas de conhecimento
base_conhecimento/*

# Libera apenas o arquivo de exemplo para ir para o Git
!base_conhecimento/exemplo_apresentacao.md